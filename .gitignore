# Environment & Secrets (IMPORTANT: Never commit real secrets)
.env
.env.local
.env.*.local
*.pem
*.key
secrets/
credentials.json
*.env

# OpenClaw runtime data and backups
data/
backup/

# Temporary files
tmp/
temp/
*.tmp
*.temp
*.swp
*.swo
.cache/
*.pid
*.seed
*.pid.lock

# OS generated
.DS_Store
Thumbs.db

